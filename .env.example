# 로컬 개발용 환경변수 예시. 실제 값은 .env.local 에 둔다(커밋 금지).

# 카카오 JS SDK 키(웹 로그인·지도)
NEXT_PUBLIC_KAKAO_JS_KEY=
# 카카오 네이티브 앱 키. capacitor.config.ts 와 android/app/build.gradle 이 읽는다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 웹 번들에서 참조하지 않는 값이다.
KAKAO_NATIVE_APP_KEY=
# BE 호출용 API 키
NEXT_PUBLIC_DITTO_API_KEY=

# GA4 측정 ID(G-XXXXXXXXXX).
#
# 비워 두면 계측 코드가 **전부 no-op** 이다. 로컬 dev · Cypress · Storybook 은
# 값을 주지 않아 자동으로 꺼진다 — 개발 중 트래픽이 프로덕션 속성에 섞이지 않는다.
#
# 프로덕션 값은 GitHub Actions secret(NEXT_PUBLIC_GA_MEASUREMENT_ID)로만 주입한다.
# output: 'export' 라 빌드 시점에 정적 치환되므로, secret 을 빠뜨리면 빌드는
# 성공하고 배포된 사이트에서만 계측이 꺼진다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
