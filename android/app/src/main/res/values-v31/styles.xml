<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ 는 시스템 스플래시를 직접 그린다. values/styles.xml 의
      android:background="@drawable/splash" 는 View 속성이라 여기서는 무시되고,
      지정하지 않으면 기본 windowBackground(흰색/검정)가 깔린다.

      windowSplashScreenAnimatedIcon 은 전용 drawable(splash_icon = 워드마크 + 베타 배지)을
      가리킨다. 비우면 런처 아이콘을 쓰는데, 베타 런처 아이콘은 하단에 검은 BETA 띠가 있어
      원형으로 잘린 띠가 스플래시에 떠 버린다. splash_icon 은 웹 스플래시
      (components/splash/Splash.tsx)와 같은 그림이고 scripts/generate-app-assets.mjs 가 만든다.

      postSplashScreenTheme 도 두지 않는다. Capacitor 의 BridgeActivity 가
      onCreate 에서 직접 setTheme 을 부르므로 중복이다.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
