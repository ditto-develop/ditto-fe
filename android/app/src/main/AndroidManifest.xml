<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          푸시 알림 상태바 아이콘.

          지정하지 않으면 안드로이드가 런처 아이콘을 쓰는데, 시스템이 알파만 남기고
          전부 흰색으로 칠하기 때문에 꽉 찬 타일인 우리 런처 아이콘은 **흰 사각형**이
          되어 버린다. 워드마크 모양만 남긴 자산을 따로 둔다
          (scripts/generate-app-assets.mjs 가 생성 — 손으로 만들지 말 것).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ditto" />

        <!--
          카카오 네이티브 로그인 리다이렉트 수신기.

          카카오계정(웹) 로그인은 커스텀 탭에서 `kakao{네이티브앱키}://oauth` 로 돌아오는데,
          이 액티비티가 선언돼 있지 않으면 **로그인 창은 뜨지만 앱으로 결과가 돌아오지 않는다**.
          스킴의 앱 키는 app/build.gradle 의 manifestPlaceholder 에서 채워진다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 그룹채팅 장소 지도(PlaceMapPage)의 navigator.geolocation 용. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 13+ 푸시 알림 표시 권한. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      CAMERA 는 일부러 선언하지 않는다. 사진 첨부(<input type="file">)는 시스템
      파일 선택기 인텐트로 처리되어 권한이 필요 없고, CAMERA 를 선언하는 순간
      런타임 승인까지 받아야 촬영이 동작하게 되어 오히려 실패 경로가 늘어난다.
    -->
</manifest>
