{
  "name": "ditto-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:run:e2e": "env -u ELECTRON_RUN_AS_NODE cypress run --config baseUrl=http://localhost:3100",
    "test:e2e:cypress": "start-server-and-test dev:e2e http://localhost:3100 cypress:run:e2e",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-client": "openapi --input ./ditto-api.json --output ./src/shared/lib/api/generated --client fetch",
    "cf:rewrite": "node scripts/generate-cf-rewrite-function.mjs",
    "cf:rewrite:check": "node scripts/generate-cf-rewrite-function.mjs --check",
    "verify:domains": "node scripts/verify-domains.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@stomp/stompjs": "^7.3.0",
    "firebase": "^12.18.0",
    "framer-motion": "^12.23.26",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@chromatic-com/storybook": "^3.0.0",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-docs": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "cypress": "^15.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^0.11.0",
    "msw": "^2.14.6",
    "openapi-typescript-codegen": "^0.30.0",
    "start-server-and-test": "^3.0.5",
    "storybook": "^8.4.7",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
